<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ page_title }}</title><link rel="stylesheet" href="{{ assets_prefix }}assets/css/site.css"></head>
<body data-target="{{ target.id }}"><script>window.RESUME_DATA = {{ js_data | safe }};</script><script src="{{ assets_prefix }}assets/js/theme.js"></script><script src="{{ assets_prefix }}assets/js/i18n.js"></script>
<header class="wrap hero"><div class="hero-top"><div><div class="eyebrow" data-i18n-target-title>{{ title_text }}</div><h1 data-i18n-name>{{ name_text }}</h1><p class="lead" data-i18n-summary>{{ summary_text }}</p></div><div class="controls"><div class="switch-row"><div class="mode-switch"><button data-theme-mode="auto"></button><button data-theme-mode="light"></button><button data-theme-mode="dark"></button></div><div class="lang-switch"><button data-lang="uk"></button><button data-lang="en"></button></div></div><div class="download-row"><a class="btn primary" href="{{ downloads_prefix }}resume.pdf" data-i18n-btn-pdf></a><a class="btn" href="{{ downloads_prefix }}resume.docx" data-i18n-btn-word></a><a class="btn" href="{{ downloads_prefix }}resume.md" data-i18n-btn-markdown></a></div></div></div><nav class="profile-nav"><a href="{{ root_prefix }}index.html" class="{% if target.id=='full' %}active{% endif %}" data-i18n-nav-full></a><a href="{{ root_prefix }}dotnet/index.html" class="{% if target.id=='dotnet' %}active{% endif %}" data-i18n-nav-dotnet></a><a href="{{ root_prefix }}delphi/index.html" class="{% if target.id=='delphi' %}active{% endif %}" data-i18n-nav-delphi></a><a href="{{ root_prefix }}web/index.html" class="{% if target.id=='web' %}active{% endif %}" data-i18n-nav-web></a></nav></header><main class="wrap"><section class="summary-grid"><article class="card one-screen"><h2 data-i18n-section-summary_cards></h2><ul class="compact-list">{% for item in overview_points %}<li data-uk="{{ item.uk }}" data-en="{{ item.en }}">{{ item.en }}</li>{% endfor %}</ul><div class="hint" data-i18n-details-anchor></div></article><article class="card one-screen"><h2 data-i18n-section-stack></h2><div class="chips">{% for skill in highlight_skills %}<span>{{ skill }}</span>{% endfor %}</div></article><article class="card one-screen"><h2 data-i18n-section-strengths></h2><ul class="compact-list">{% for item in achievements %}<li data-uk="{{ item.text.uk }}" data-en="{{ item.text.en }}">{{ item.text.en }}</li>{% endfor %}</ul></article><article class="card one-screen"><h2 data-i18n-section-education></h2><ul class="compact-list">{% for e in education %}<li><strong data-uk="{{ e.specialty.uk }}" data-en="{{ e.specialty.en }}">{{ e.specialty.en }}</strong><br><span data-uk="{{ e.institution.uk }}" data-en="{{ e.institution.en }}">{{ e.institution.en }}</span><span class="muted"> • {{ e.period }}</span></li>{% endfor %}</ul></article></section><section class="card details-block"><h2 data-i18n-section-projects></h2><div class="project-grid">{% for p in projects %}<article class="project"><h3 data-uk="{{ p.name.uk }}" data-en="{{ p.name.en }}">{{ p.name.en }}</h3><div class="muted" data-uk="{{ p.role.uk }}" data-en="{{ p.role.en }}">{{ p.role.en }}</div><div class="muted">{{ p.period }}</div><p data-uk="{{ p.description.uk }}" data-en="{{ p.description.en }}">{{ p.description.en }}</p></article>{% endfor %}</div></section><section class="card details-block"><h2 data-i18n-section-details></h2>{% for item in experiences %}<article class="job"><div class="job-head"><div><h3 data-uk="{{ item.company.uk }}" data-en="{{ item.company.en }}">{{ item.company.en }}</h3><div class="muted" data-uk="{{ item.title.uk }}" data-en="{{ item.title.en }}">{{ item.title.en }}</div></div><div class="period">{{ item.start }} – {{ item.end }}</div></div><ul class="clean">{% for bullet in item.bullets.en %}<li data-uk="{{ item.bullets.uk[loop.index0] }}" data-en="{{ bullet }}">{{ bullet }}</li>{% endfor %}</ul></article>{% endfor %}</section></main></body></html>