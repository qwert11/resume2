<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ page_title }}</title>
<meta name="description" content="{{ summary_text }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="{{ assets_prefix }}assets/css/site.css">
</head>
<body data-target="{{ target.id }}">
<script>window.RESUME_DATA = {{ js_data | safe }};</script>
<script src="{{ assets_prefix }}assets/js/theme.js"></script>

<a class="skip" href="#main">Skip to content</a>

<header class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-main">
        <p class="eyebrow" data-i18n-target-title>{{ title_text }}</p>
        <h1 data-i18n-name>{{ name_text }}</h1>
        <p class="lead" data-i18n-summary>{{ summary_text }}</p>
        <ul class="contacts">
          {%- for c in contacts %}
          <li><a href="{{ c.href }}"{% if c.href.startswith('http') %} target="_blank" rel="noopener"{% endif %}>{{ c.label }}</a></li>
          {%- endfor %}
          <li class="place" data-uk="{{ location.uk }}" data-en="{{ location.en }}">{{ location.en }}</li>
        </ul>
      </div>

      <div class="controls">
        <div class="ctl-row">
          <div class="seg" role="group" aria-label="Theme">
            <button type="button" data-theme-mode="auto"></button><button type="button" data-theme-mode="light"></button><button type="button" data-theme-mode="dark"></button>
          </div>
          <div class="seg" role="group" aria-label="Language">
            <button type="button" data-lang="uk"></button><button type="button" data-lang="en"></button>
          </div>
        </div>
        <div class="ctl-row downloads">
          <a class="btn primary" href="{{ downloads_prefix }}resume.pdf" data-dl-pdf data-i18n-btn-pdf></a>
          <a class="btn" href="{{ downloads_prefix }}resume.docx" data-dl-docx data-i18n-btn-word></a>
          <a class="btn" href="{{ downloads_prefix }}resume.md" data-dl-md data-i18n-btn-markdown></a>
        </div>
      </div>
    </div>

    <nav class="profiles" aria-label="Resume profiles">
      <span class="profiles-hint" data-i18n-profiles-hint></span>
      <a href="{{ root_prefix }}index.html" class="{% if target.id=='full' %}active{% endif %}" data-i18n-nav-full></a>
      <a href="{{ root_prefix }}dotnet/index.html" class="{% if target.id=='dotnet' %}active{% endif %}" data-i18n-nav-dotnet></a>
      <a href="{{ root_prefix }}delphi/index.html" class="{% if target.id=='delphi' %}active{% endif %}" data-i18n-nav-delphi></a>
      <a href="{{ root_prefix }}web/index.html" class="{% if target.id=='web' %}active{% endif %}" data-i18n-nav-web></a>
      <a href="{{ root_prefix }}ai/index.html" class="{% if target.id=='ai' %}active{% endif %}" data-i18n-nav-ai></a>
    </nav>
  </div>
</header>

<main id="main" class="wrap">

  <section class="metrics" aria-label="Key figures">
    {%- for m in metrics %}
    <div class="metric">
      <b>{{ m.value }}{% if m.unit.en %} <span class="unit" data-uk="{{ m.unit.uk }}" data-en="{{ m.unit.en }}">{{ m.unit.en }}</span>{% endif %}</b>
      <span data-uk="{{ m.label.uk }}" data-en="{{ m.label.en }}">{{ m.label.en }}</span>
    </div>
    {%- endfor %}
  </section>

  <div class="columns">
    <div class="col-main">

      <section class="block">
        <h2 data-i18n-section-strengths></h2>
        <ul class="impact">
          {%- for item in achievements %}
          <li data-uk="{{ item.text.uk }}" data-en="{{ item.text.en }}">{{ item.text.en }}</li>
          {%- endfor %}
        </ul>
      </section>

      <section class="block">
        <h2 data-i18n-section-projects></h2>
        <div class="projects">
          {%- for p in projects %}
          <article class="project">
            <div class="project-head">
              <h3 data-uk="{{ p.name.uk }}" data-en="{{ p.name.en }}">{{ p.name.en }}</h3>
              <span class="period">{% if p.period.endswith('present') %}{{ p.period[:-7] }}<span data-i18n-present></span>{% else %}{{ p.period }}{% endif %}</span>
            </div>
            {%- if p.role %}
            <p class="role" data-uk="{{ p.role.uk }}" data-en="{{ p.role.en }}">{{ p.role.en }}</p>
            {%- endif %}
            <p data-uk="{{ p.description.uk }}" data-en="{{ p.description.en }}">{{ p.description.en }}</p>
            {%- if p.stack %}
            <ul class="chips small">{% for s in p.stack %}<li>{{ s }}</li>{% endfor %}</ul>
            {%- endif %}
            {%- if p.link %}
            <p class="project-link"><a href="{{ p.link.href }}" target="_blank" rel="noopener">{{ p.link.label }}</a></p>
            {%- endif %}
          </article>
          {%- endfor %}
        </div>
      </section>

      <section class="block">
        <h2 data-i18n-section-details></h2>
        <div class="jobs">
          {%- for item in experiences %}
          <article class="job">
            <div class="job-when"><span class="period">{{ item.start }} — {% if item.end == 'present' %}<span data-i18n-present></span>{% else %}{{ item.end }}{% endif %}</span><span class="city" data-uk="{{ item.city.uk }}" data-en="{{ item.city.en }}">{{ item.city.en }}</span></div>
            <div class="job-body">
              <h3 data-uk="{{ item.company.uk }}" data-en="{{ item.company.en }}">{{ item.company.en }}</h3>
              {%- if item.company_note %}
              <p class="note" data-uk="{{ item.company_note.uk }}" data-en="{{ item.company_note.en }}">{{ item.company_note.en }}</p>
              {%- endif %}
              <p class="role" data-uk="{{ item.title.uk }}" data-en="{{ item.title.en }}">{{ item.title.en }}</p>
              <ul class="clean">
                {%- for bullet in item.bullets.en %}
                <li data-uk="{{ item.bullets.uk[loop.index0] }}" data-en="{{ bullet }}">{{ bullet }}</li>
                {%- endfor %}
              </ul>
            </div>
          </article>
          {%- endfor %}
          {%- if earlier.en %}
          <p class="earlier"><span data-i18n-earlier></span>: <span data-uk="{{ earlier.uk }}" data-en="{{ earlier.en }}">{{ earlier.en }}</span></p>
          {%- endif %}
        </div>
      </section>

    </div>

    <aside class="col-side">

      <section class="block">
        <h2 data-i18n-section-stack></h2>
        {%- for g in skill_groups %}
        <div class="skill-group">
          <h3 data-uk="{{ g.label.uk }}" data-en="{{ g.label.en }}">{{ g.label.en }}</h3>
          <ul class="chips">{% for s in g['items'] %}<li data-uk="{{ s.name.uk }}" data-en="{{ s.name.en }}">{{ s.name.en }}</li>{% endfor %}</ul>
        </div>
        {%- endfor %}
      </section>

      {%- if domain %}
      <section class="block">
        <h2 data-i18n-section-domain></h2>
        <dl class="domain">
          {%- for d in domain %}
          <dt data-uk="{{ d.term.uk }}" data-en="{{ d.term.en }}">{{ d.term.en }}</dt>
          <dd data-uk="{{ d.note.uk }}" data-en="{{ d.note.en }}">{{ d.note.en }}</dd>
          {%- endfor %}
        </dl>
      </section>
      {%- endif %}

      {%- if side_projects %}
      <section class="block">
        <h2 data-i18n-section-side></h2>
        <ul class="side">
          {%- for x in side_projects %}
          <li>
            <a href="{{ x.link }}" target="_blank" rel="noopener" data-uk="{{ x.name.uk }}" data-en="{{ x.name.en }}">{{ x.name.en }}</a>
            <span data-uk="{{ x.note.uk }}" data-en="{{ x.note.en }}">{{ x.note.en }}</span>
          </li>
          {%- endfor %}
        </ul>
      </section>
      {%- endif %}

      <section class="block">
        <h2 data-i18n-section-education></h2>
        <ul class="edu">
          {%- for e in education %}
          <li class="{{ e.kind }}">
            <strong data-uk="{{ e.specialty.uk }}" data-en="{{ e.specialty.en }}">{{ e.specialty.en }}</strong>
            <span data-uk="{{ e.institution.uk }}" data-en="{{ e.institution.en }}">{{ e.institution.en }}</span>
            {%- if e.period %}<span class="period">{{ e.period }}</span>{% endif %}
          </li>
          {%- endfor %}
        </ul>
      </section>

      <section class="block">
        <h2 data-i18n-section-languages></h2>
        <ul class="langs">
          {%- for l in languages %}
          <li><strong data-uk="{{ l.name.uk }}" data-en="{{ l.name.en }}">{{ l.name.en }}</strong> <span data-uk="{{ l.level.uk }}" data-en="{{ l.level.en }}">{{ l.level.en }}</span></li>
          {%- endfor %}
        </ul>
      </section>

    </aside>
  </div>
</main>

<footer class="wrap site-foot">
  <p><span data-i18n-name>{{ name_text }}</span> · <span data-i18n-target-title>{{ title_text }}</span></p>
  <p class="muted">{{ build_date }}</p>
</footer>

<script src="{{ assets_prefix }}assets/js/i18n.js"></script>
</body>
</html>
